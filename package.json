{
  "name": "tsnilla-rss",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite &&  cp sw.js dist/",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "node -e \"require('dotenv').config(); require('child_process').execSync('npx chromatic --project-token=' + process.env.CHROMATIC_PROJECT_TOKEN , { stdio: 'inherit' })\"",
